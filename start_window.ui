            <property name="styleSheet">
             <string notr="true">QPushButton {
    background-color: #EF4444; /* Красный цвет из Figma */
    color: white;
    border-radius: 8px;
    font: bold 16pt &quot;Inter&quot;, &quot;Arial&quot;;
    min-height: 60px; /* Чтобы она не была слишком тонкой */
    min-width: 200px;
}
QPushButton:pressed {
    background-color: #B91C1C;
}</string>
            </property>
