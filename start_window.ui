  <property name="styleSheet">
   <string notr="true">/* === ГЛОБАЛЬНЫЙ ФОН === */
QMainWindow, QWidget#centralwidget {
    background-color: #101828;
}

/* === ВЕРХНЯЯ ПАНЕЛЬ (топбар) === */
QFrame#frameTopBar {
    background-color: #1E2939;
    border: 1px solid #364153;
    border-left: none;
    border-right: none;
}

/* Кнопки иконок в топбаре */
QPushButton#btnTopSwitch, QPushButton#btnTopBack,
QPushButton#btnTopSettings, QPushButton#btnTopHome {
    background-color: transparent;
    border: none;
    border-radius: 8px;
}
QPushButton#btnTopSwitch:hover, QPushButton#btnTopBack:hover,
QPushButton#btnTopSettings:hover, QPushButton#btnTopHome:hover {
    background-color: #334155;
}
QPushButton#btnTopSwitch:pressed, QPushButton#btnTopBack:pressed,
QPushButton#btnTopSettings:pressed, QPushButton#btnTopHome:pressed {
    background-color: #475569;
}

/* Текст в топбаре (текущий режим) */
QLabel#lblCurrentMainMode {
    color: #818181;
    font-family: 'Roboto', 'Arial', sans-serif;
    font-size: 24px;
    font-weight: 400;
    background-color: transparent;
}

/* === СТРАНИЦА ВЫБОРА РЕЖИМА (проволока/порошок) === */
QPushButton#btnWire, QPushButton#btnPowder {
    background-color: #1E2939;
    color: white;
    border: 1px solid #364153;
    border-radius: 15px;
    font-family: 'Roboto', 'Arial', sans-serif;
    font-size: 28px;
    font-weight: 400;
    min-height: 180px;
    min-width: 300px;
}
QPushButton#btnWire:hover, QPushButton#btnPowder:hover {
    background-color: #334155;
}
QPushButton#btnWire:pressed, QPushButton#btnPowder:pressed {
    background-color: #1E2939;
}

/* Кнопка Выход */
QPushButton#btnExit {
    background-color: #EF4444;
    color: white;
    border: none;
    border-radius: 10px;
    font-family: 'Roboto', 'Arial', sans-serif;
    font-size: 20px;
    font-weight: 400;
    min-height: 50px;
    min-width: 180px;
}
QPushButton#btnExit:hover {
    background-color: #DC2626;
}
QPushButton#btnExit:pressed {
    background-color: #B91C1C;
}

/* === СТРАНИЦА УПРАВЛЕНИЯ (page_2) === */
/* Шапка (frameHeader) */
QFrame#frameHeader {
    background-color: transparent;
    margin: 0px;
    padding: 10px 20px;
}
QLabel#lblSystemStatus {
    background-color: transparent;
    color: #FFFFFF;
    font-family: 'Roboto', 'Arial', sans-serif;
    font-size: 24px;
    font-weight: 400;
}
QLabel#lblCurrentMode {
    color: #818181;
    font-family: 'Roboto', 'Arial', sans-serif;
    font-size: 24px;
    font-weight: 400;
    background-color: transparent;
}

/* Кнопки СТАРТ и СТОП */
QPushButton#btnStart {
    background-color: #22C55E;
    color: white;
    border: none;
    border-radius: 10px;
    font-family: 'Roboto', 'Arial', sans-serif;
    font-size: 20px;
    font-weight: 400;
    min-width: 180px;
    min-height: 50px;
}
QPushButton#btnStart:hover {
    background-color: #16A34A;
}
QPushButton#btnStart:pressed {
    background-color: #15803D;
}
QPushButton#btnStop {
    background-color: #EF4444;
    color: white;
    border: none;
    border-radius: 10px;
    font-family: 'Roboto', 'Arial', sans-serif;
    font-size: 20px;
    font-weight: 400;
    min-width: 180px;
    min-height: 50px;
}
QPushButton#btnStop:hover {
    background-color: #DC2626;
}
QPushButton#btnStop:pressed {
    background-color: #B91C1C;
}

/* === КАРТОЧКИ &quot;ЗАЖИГАНИЕ ДУГИ&quot; И &quot;СИСТЕМА ПОДАЧИ&quot; (layoutModules) === */
QFrame#frameIgnition, QFrame#frameFeeding {
    background-color: #1E2939;
    border-radius: 15px;
    border: 1px solid #364153;
    padding: 15px;
}
/* Заголовки внутри карточек */
QFrame#frameIgnition QLabel:first-child, 
QFrame#frameFeeding QLabel:first-child {
    color: #FFFFFF;
    font-family: 'Roboto', 'Arial', sans-serif;
    font-size: 22px;
    font-weight: 500;
}
/* Строка &quot;Система:Активна&quot; (единый стиль, т.к. в .ui это один QLabel) */
QLabel#label_25, QLabel#label {
    color: #818181;
    font-family: 'Roboto', 'Arial', sans-serif;
    font-size: 18px;
    font-weight: 400;
    background-color: transparent;
}
/* Чекбоксы внутри карточек модулей – стилизуем как переключатели iOS */
QFrame#frameIgnition QCheckBox, 
QFrame#frameFeeding QCheckBox {
    spacing: 8px;
}
QFrame#frameIgnition QCheckBox::indicator,
QFrame#frameFeeding QCheckBox::indicator {
    width: 51px;
    height: 31px;
    border-radius: 100px;
    background-color: #64748B;
}
QFrame#frameIgnition QCheckBox::indicator:checked,
QFrame#frameFeeding QCheckBox::indicator:checked {
    background-color: #007AFF;
}
QFrame#frameIgnition QCheckBox, 
QFrame#frameFeeding QCheckBox {
    text: &quot;&quot;;
}

/* === КАРТОЧКИ ГАЗОВ === */
QFrame#framePropane_2, QFrame#frameOxygen, QFrame#frameAir,
QFrame#frameQgas_Feeder, QFrame#framePistol_Patatel {
    background-color: #1E2939;
    border-radius: 15px;
    border: none;
}
QLabel[objectName$=&quot;Name&quot;] {
    color: #818181;
    font-family: 'Roboto', 'Arial', sans-serif;
    font-size: 24px;
    font-weight: 400;
}

/* === БЛОКИ &quot;РАБОЧЕЕ ЗНАЧЕНИЕ&quot; И &quot;ТЕКУЩЕЕ ЗНАЧЕНИЕ&quot; (серые прямоугольники) === */
QFrame#frameWorkValue, QFrame#frameWorkValue_2, QFrame#frameWorkValue_3,
QFrame#frameWorkValue_4, QFrame#frameWorkValue_5,
QFrame#frameCurrentValue, QFrame#frameCurrentValue_2, QFrame#frameCurrentValue_3,
QFrame#frameCurrentValue_4, QFrame#frameCurrentValue_5 {
    background-color: #364153;
    border-radius: 15px;
    border: none;
    padding: 8px;
}

/* Подписи &quot;Рабочее значение&quot; и &quot;Текущее значение&quot; */
QLabel[text=&quot;Рабочее значение&quot;], QLabel[text=&quot;Текущее значение&quot;] {
    font-family: 'Roboto', 'Arial', sans-serif;
    font-size: 14px;
    font-weight: 400;
}
QLabel[text=&quot;Рабочее значение&quot;] {
    color: #FFFFFF;
}
QLabel[text=&quot;Текущее значение&quot;] {
    color: #818181;
}
/* Значения (50.0 л/с) */
QLabel[objectName$=&quot;WorkWalue&quot;], QLabel[objectName$=&quot;WorkValue&quot;],
QLabel[objectName$=&quot;CurrentWalue&quot;], QLabel[objectName$=&quot;CurrentValue&quot;] {
    font-family: 'Roboto', 'Arial', sans-serif;
    font-size: 36px;
    font-weight: 400;
}
QLabel[objectName$=&quot;WorkWalue&quot;], QLabel[objectName$=&quot;WorkValue&quot;] {
    color: #FFFFFF;
}
QLabel[objectName$=&quot;CurrentWalue&quot;], QLabel[objectName$=&quot;CurrentValue&quot;] {
    color: #818181;
}

/* === КНОПКИ SET === */
QPushButton[objectName$=&quot;Set&quot;] {
    background-color: #007AFF;
    color: white;
    border: none;
    border-radius: 20px;
    font-family: 'Roboto', 'Arial', sans-serif;
    font-size: 24px;
    font-weight: 400;
    min-width: 112px;
    min-height: 48px;
}
QPushButton[objectName$=&quot;Set&quot;]:hover {
    background-color: #005BB5;
}
QPushButton[objectName$=&quot;Set&quot;]:pressed {
    background-color: #004099;
}

/* === КНОПКИ + и - === */
QPushButton[objectName$=&quot;Decrease&quot;], QPushButton[objectName$=&quot;decrease&quot;] {
    background-color: transparent;
    color: #FFFFFF;
    border: none;
    font-family: 'Roboto', 'Arial', sans-serif;
    font-size: 64px;
    font-weight: 400;
}
QPushButton[objectName$=&quot;Increase&quot;], QPushButton[objectName$=&quot;increase&quot;] {
    background-color: transparent;
    color: #FFFFFF;
    border: none;
    font-family: 'Roboto', 'Arial', sans-serif;
    font-size: 32px;
    font-weight: 400;
}
QPushButton[objectName$=&quot;Decrease&quot;]:hover, QPushButton[objectName$=&quot;Increase&quot;]:hover,
QPushButton[objectName$=&quot;decrease&quot;]:hover, QPushButton[objectName$=&quot;increase&quot;]:hover {
    color: #94A3B8;
}

/* === ПЕРЕКЛЮЧАТЕЛИ iOS (QCheckBox для газов и модулей) === */
QCheckBox[objectName$=&quot;Switch&quot;] {
    spacing: 8px;
}
QCheckBox[objectName$=&quot;Switch&quot;]::indicator {
    width: 51px;
    height: 31px;
    border-radius: 100px;
}
QCheckBox[objectName$=&quot;Switch&quot;]::indicator:unchecked {
    background-color: #64748B;
}
QCheckBox[objectName$=&quot;Switch&quot;]::indicator:checked {
    background-color: #007AFF;
}
QCheckBox[objectName$=&quot;Switch&quot;] {
    text: &quot;&quot;;
}

/* === ДОПОЛНИТЕЛЬНО: стиль для текста &quot;Активна&quot; / &quot;Система:&quot; (если разделите на два лейбла) === */
QLabel[text=&quot;Активна&quot;] {
    color: #FFFFFF;
    font-family: 'Roboto', 'Arial', sans-serif;
    font-size: 18px;
}
QLabel[text=&quot;Система:&quot;] {
    color: #818181;
    font-family: 'Roboto', 'Arial', sans-serif;
    font-size: 18px;
}

/* === СКРОЛЛБАРЫ === */
QScrollBar:vertical {
    background: #1E2939;
    width: 10px;
    border-radius: 5px;
}
QScrollBar::handle:vertical {
    background: #475569;
    border-radius: 5px;
}
QScrollBar::handle:vertical:hover {
    background: #64748B;
}
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0px;
}
/* === ЭКРАН РЕЦЕПТОВ (page_3) === */
QFrame#frameTopBar_3 {
    background-color: #1E2939;
    border: 1px solid #364153;
    border-left: none;
    border-right: none;
}
QPushButton#btnRecipesBack {
    background-color: transparent;
    border: none;
    border-radius: 8px;
    color: #FFFFFF;
    font-size: 20px;
}
QPushButton#btnRecipesBack:hover { background-color: #334155; }
QPushButton#btnRecipesBack:pressed { background-color: #475569; }
QLabel#lblRecipesTitle {
    color: #FFFFFF;
    font-family: 'Roboto', 'Arial', sans-serif;
    font-size: 24px;
    font-weight: 500;
    background-color: transparent;
}
QTableWidget#tableRecipes {
    background-color: #1E2939;
    alternate-background-color: #253347;
    color: #FFFFFF;
    font-family: 'Roboto', 'Arial', sans-serif;
    font-size: 18px;
    border: 1px solid #364153;
    border-radius: 12px;
    gridline-color: #364153;
    selection-background-color: #FFFFFF;
    selection-color: #101828;
}
QTableWidget#tableRecipes QHeaderView::section {
    background-color: #364153;
    color: #818181;
    font-size: 16px;
    font-weight: 500;
    border: none;
    padding: 8px;
}
QTableWidget#tableRecipes::item { padding: 10px; border: none; }
QTableWidget#tableRecipes::item:selected {
    background-color: #FFFFFF;
    color: #101828;
}
QPushButton#btnRecipeUp, QPushButton#btnRecipeDown {
    background-color: #1E2939;
    color: #FFFFFF;
    border: 1px solid #364153;
    border-radius: 12px;
    font-size: 24px;
}
QPushButton#btnRecipeUp:hover, QPushButton#btnRecipeDown:hover { background-color: #334155; }
QPushButton#btnRecipeUp:pressed, QPushButton#btnRecipeDown:pressed { background-color: #475569; }
QPushButton#btnRecipeSelect {
    background-color: #22C55E;
    color: #FFFFFF;
    border: none;
    border-radius: 12px;
    font-family: 'Roboto', 'Arial', sans-serif;
    font-size: 16px;
    font-weight: 500;
    padding: 10px;
}
QPushButton#btnRecipeSelect:hover { background-color: #16A34A; }
QPushButton#btnRecipeSelect:pressed { background-color: #15803D; }</string>
